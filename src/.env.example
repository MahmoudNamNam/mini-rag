# ----------------------------------------------------------------------------
# mini-rag – Example environment configuration
# Copy this file to `.env` and fill in the secrets.
# Lists accept JSON arrays (preferred) or comma-separated strings.
# ----------------------------------------------------------------------------

# --- App Information ---
APP_NAME="mini-rag"
APP_VERSION="0.1.0"
APP_DESCRIPTION="A minimal RAG application"

# --- File Configuration ---
# Allowed MIME types for uploads
FILE_ALLOWED_TYPES=["text/plain","application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
# Max upload size in MB
FILE_MAX_SIZE=10
# Default chunk size in bytes
FILE_DEFAULT_CHUNK_SIZE=512000

# --- MongoDB (required if you use Mongo features) ---
MONGO_URI="mongodb://admin:admin@localhost:27017/?authSource=admin"
MONGO_DB_NAME="mini_rag"

# --- PostgreSQL (required if you use PG features) ---
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="change_me"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="minirag"

# --- LLM Backends ---
GENERATION_BACKEND_LITERAL=["OPENAI","COHERE","AZURE_OPENAI","LOCAL"]
GENERATION_BACKEND="COHERE"

EMBEDDING_BACKEND_LITERAL=["OPENAI","COHERE","AZURE_OPENAI","LOCAL"]
EMBEDDING_BACKEND="COHERE"

# --- API Keys / Endpoints ---
OPENAI_API_KEY=""
OPENAI_API_URL="https://api.openai.com/v1"
COHERE_API_KEY=""

# --- LLM Models ---
GENERATION_MODEL_ID_LITERAL=["gpt-3.5-turbo","gpt-4o-mini","command-r"]
GENERATION_MODEL_ID="command-r"

EMBEDDING_MODEL_ID_LITERAL=["text-embedding-ada-002","embed-multilingual-light-v3.0"]
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

# --- Input and Output Limits ---
INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.2

# --- Vector Database ---
VECTOR_DB_BACKEND_LITERAL=["QDRANT","PGVECTOR","FAISS"]
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"

VECTOR_DB_DISTANCE_METHOD_LITERAL=["cosine","euclidean","dot"]
VECTOR_DB_DISTANCE_METHOD="cosine"

# --- Language settings ---
PRIMARY_LANG_LITERAL=["en","fr","ar","de"]
PRIMARY_LANG="en"
DEFAULT_LANG="en"

